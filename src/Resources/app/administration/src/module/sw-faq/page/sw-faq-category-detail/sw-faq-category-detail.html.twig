{% block sw_faq_category_detail %}
    <sw-page class="sw-faq-category-detail">
        {% block sw_faq_category_detail_header %}
            <template #smart-bar-header>
                <h2>{{ placeholder(category, 'name', $tc('sw-faq.category.detail.textHeadline')) }}</h2>
            </template>
        {% endblock %}

        {% block sw_faq_category_detail_actions %}
            <template #smart-bar-actions>
                <mt-button
                    v-tooltip.bottom="tooltipCancel"
                    :disabled="categoryIsLoading"
                    variant="secondary"
                    size="default"
                    @click="onCancel"
                >
                    {{ $tc('global.default.cancel') }}
                </mt-button>
                <sw-button-process
                    v-model:process-success="isSaveSuccessful"
                    v-tooltip.bottom="tooltipSave"
                    class="sw-faq-category-detail__save-action"
                    :is-loading="isLoading"
                    :disabled="isLoading"
                    variant="primary"
                    @click.prevent="onSave"
                >
                    {{ $tc('sw-faq.category.detail.buttonSave') }}
                </sw-button-process>
            </template>
        {% endblock %}

        {% block sw_faq_category_detail_language_switch %}
            <template #language-switch>
                <sw-language-switch
                    :disabled="isCreate(categoryId) || isCreate($route.params.id)"
                    :save-changes-function="saveOnLanguageChange"
                    :abort-change-function="abortOnLanguageChange"
                    @on-change="onChangeLanguage"
                />
            </template>
        {% endblock %}

        {% block sw_faq_category_detail_content %}
            <template #content>
                <sw-card-view>
                    <template v-if="categoryIsLoading">
                        <sw-skeleton variant="detail-bold" />
                        <sw-skeleton />
                    </template>

                    <template v-else>
                        {% block sw_faq_category_detail_content_language_info %}
                            <sw-language-info
                                :entity-description="placeholder(category, 'name', $tc('sw-faq.category.detail.textHeadline'))"
                            />
                        {% endblock %}

                        {% block sw_faq_category_detail_base_info_card %}
                            <mt-card
                                position-identifier="sw-faq-category-detail-base-info"
                                :title="$tc('sw-faq.category.detail.cardTitleCategoryInfo')"
                            >
                                {% block sw_faq_category_detail_base_info_field_name %}
                                    <mt-text-field
                                        v-model="category.name"
                                        :label="$tc('sw-faq.category.detail.labelName')"
                                        :placeholder="placeholder(category, 'name', $tc('sw-faq.category.detail.placeholderName'))"
                                        name="name"
                                        validation="required"
                                        required
                                        :error="categoryNameError"
                                    />
                                {% endblock %}
                            </mt-card>
                        {% endblock %}
                    </template>
                </sw-card-view>
            </template>
        {% endblock %}
    </sw-page>
{% endblock %}
